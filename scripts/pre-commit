#!/usr/bin/env bash
# clang-format gate for staged C++ files. Install with:
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
set -euo pipefail

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.h')
if [ -z "$files" ]; then
  exit 0
fi

if ! clang-format --dry-run --Werror $files; then
  echo "clang-format check failed. Fix with:" >&2
  echo "  clang-format -i $files" >&2
  exit 1
fi
